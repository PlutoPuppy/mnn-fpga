+    // Accept both framework-cast tensors and explicitly typed INT8 tensors.
+    // Both require one-byte signed INT8 storage and calibrated quant metadata.
+    const auto traceIn = TensorUtils::getDescribe(inputs[0]);
+    const auto traceOut = TensorUtils::getDescribe(outputs[0]);
+    MnnFpgaInt8Trace trace(inputs[0]->host<int8_t>(), outputs[0]->host<int8_t>(),
+        inputs[0]->batch(), inputs[0]->channel(), outputs[0]->channel(),
+        static_cast<CPUBackend*>(backend())->functions()->pack == 4 &&
