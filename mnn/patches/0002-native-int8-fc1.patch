+        (traceOut->applyQuant || outputs[0]->getType() == halide_type_of<int8_t>()) &&
+        traceIn->dimensionFormat == MNN_DATA_FORMAT_NC4HW4 && traceOut->dimensionFormat == MNN_DATA_FORMAT_NC4HW4 &&
+        CPUBackend::getBytes(backend(), inputs[0]) == 1 && CPUBackend::getBytes(backend(), outputs[0]) == 1 &&
+        inputs[0]->height() == 1 && inputs[0]->width() == 1 && outputs[0]->height() == 1 && outputs[0]->width() == 1);
+    if (mnn_fpga_linear_int8_active()) {
+        const auto input = inputs[0];
+        const auto output = outputs[0];
+        const auto inDesc = TensorUtils::getDescribe(input);
+        const auto outDesc = TensorUtils::getDescribe(output);
+        const auto cpu = static_cast<CPUBackend*>(backend());
+        if (inputs.size() != 1 || outputs.size() != 1 || cpu->functions()->pack != 4 ||
+            CPUBackend::getBytes(backend(), input) != 1 || CPUBackend::getBytes(backend(), output) != 1 ||
+            inDesc->dimensionFormat != MNN_DATA_FORMAT_NC4HW4 || outDesc->dimensionFormat != MNN_DATA_FORMAT_NC4HW4 ||
+            (!inDesc->applyQuant && input->getType() != halide_type_of<int8_t>()) ||
+            (!outDesc->applyQuant && output->getType() != halide_type_of<int8_t>()) ||
+            !inDesc->quantAttr || !outDesc->quantAttr ||
+            inDesc->quantAttr->type != DataType_DT_INT8 || outDesc->quantAttr->type != DataType_DT_INT8 ||
+            input->height() != output->height() || input->width() != output->width() || input->batch() != output->batch() ||
+            (!mnn_fpga_native_active() && (input->height() != 1 || input->width() != 1)) ||
+            (input->batch() != 1 && (input->height() != 1 || input->width() != 1))) {
+            MNN_ERROR("Native fc1 FPGA hook requires real INT8 NC4HW4, pack4, H=W=1\n");
+            return INVALID_VALUE;
+        }
+        const int done = mnn_fpga_try_linear_int8(input->host<int8_t>(), output->host<int8_t>(),
+            size_t(input->batch()) * input->height() * input->width(), input->channel(), output->channel(), inDesc->quantAttr->scale,
+            outDesc->quantAttr->scale, inDesc->quantAttr->zero, outDesc->quantAttr->zero);
+        return done == 1 ? NO_ERROR : INVALID_VALUE;
+    }
+#endif
     if (mResourceInt8->mWeightQuantInfoMode && !mResourceInt8->mCompactReady.load(std::memory_order_acquire)) {
