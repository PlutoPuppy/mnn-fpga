# Optional Windows-host cross-build using a workspace-local Zig 0.13 toolchain.
# Set -DZIG_EXE=/absolute/path/to/zig.exe and use the Ninja generator.
set(CMAKE_SYSTEM_NAME Linux)
# MNN's armv7 branch adds GCC -march flags Zig parses as CPU names. The
# actual CPU/features are supplied explicitly below; "arm" selects AArch32.
set(CMAKE_SYSTEM_PROCESSOR arm)
set(ARCHS armv7 CACHE STRING "MNN assembly architecture")
if(NOT ZIG_EXE)
    message(FATAL_ERROR "Set ZIG_EXE to a Zig compiler executable")
endif()
file(TO_CMAKE_PATH "${ZIG_EXE}" ZIG_EXE)
set(CMAKE_C_COMPILER "${ZIG_EXE}")
set(CMAKE_CXX_COMPILER "${ZIG_EXE}")
set(CMAKE_ASM_COMPILER "${ZIG_EXE}")
set(CMAKE_C_COMPILER_ARG1 cc)
set(CMAKE_CXX_COMPILER_ARG1 "c++")
set(CMAKE_ASM_COMPILER_ARG1 cc)
set(CMAKE_ASM_COMPILER_ID Clang)
set(CMAKE_AR "${ZIG_EXE}")
set(CMAKE_RANLIB "${ZIG_EXE}")
set(CMAKE_C_ARCHIVE_CREATE "<CMAKE_AR> ar qc <TARGET> <LINK_FLAGS> <OBJECTS>")
set(CMAKE_CXX_ARCHIVE_CREATE "<CMAKE_AR> ar qc <TARGET> <LINK_FLAGS> <OBJECTS>")
set(CMAKE_C_ARCHIVE_FINISH "<CMAKE_RANLIB> ranlib <TARGET>")
set(CMAKE_CXX_ARCHIVE_FINISH "<CMAKE_RANLIB> ranlib <TARGET>")
set(CMAKE_C_FLAGS_INIT "-target arm-linux-musleabihf -mcpu=cortex_a9")
set(CMAKE_CXX_FLAGS_INIT "-target arm-linux-musleabihf -mcpu=cortex_a9")
set(CMAKE_ASM_FLAGS_INIT "-target arm-linux-musleabihf -mcpu=cortex_a9")
set(CMAKE_EXE_LINKER_FLAGS_INIT "-static")
set(CMAKE_TRY_COMPILE_TARGET_TYPE STATIC_LIBRARY)
set(CMAKE_TRY_COMPILE_PLATFORM_VARIABLES ZIG_EXE)
